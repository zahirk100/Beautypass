# Copy to .env.development.local for `npm run dev` (only loaded in dev, never in a build). In production these live in Vercel → Settings → Environment Variables.
# Browser (public): the Supabase project URL and publishable key
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
# Server only (never prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://www.beautypass.nl
# Payments: without a Mollie account set PAYMENTS_DEMO=1 (test checkout, nothing is paid; run migration 003).
# Remove it as soon as MOLLIE_API_KEY is set. A live_ key always switches demo mode off.
PAYMENTS_DEMO=
MOLLIE_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=hallo@beautypass.nl
NOTIFY_SECRET=
CRON_SECRET=
# Optional, for local tests with scripts/mock-providers.mjs
MOLLIE_API_URL=
MOLLIE_WEBHOOK_URL=
BREVO_API_URL=
